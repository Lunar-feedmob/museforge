{
  "$defs": {
    "SourceKind": {
      "enum": [
        "github",
        "web",
        "community",
        "official"
      ],
      "title": "SourceKind",
      "type": "string"
    }
  },
  "description": "A repository or origin that knowledge was derived from.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "url": {
      "title": "Url",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/SourceKind",
      "default": "github"
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License"
    },
    "allowed_usage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Allowed Usage"
    },
    "redistribution_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Redistribution Status"
    },
    "attribution_requirements": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attribution Requirements"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "last_checked": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Checked"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "url"
  ],
  "title": "Source",
  "type": "object"
}
