# MuseForge configuration (copy to .env and fill in as needed).
# The core path works with NO keys — the Assistant falls back to deterministic heuristics.

# --- LLM provider (optional) ---
# Used for intent understanding, knowledge extraction, creative direction, and composition.
# Leave unset to use the deterministic heuristic fallback.
MUSEFORGE_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Embedding provider (optional) ---
# Used for semantic dedup and semantic search.
# Leave unset to use the local (hash/TF-IDF) fallback.
MUSEFORGE_EMBEDDING_PROVIDER=local

# --- Knowledge store ---
MUSEFORGE_DATA_DIR=data

# --- MCP HTTP server (Google OAuth + Streamable HTTP transport) ---
# Public base URL clients see. Must match Google OAuth's Authorized redirect URI.
MUSEFORGE_PUBLIC_BASE_URL=http://localhost:8000
# Override only if your OAuth client uses a redirect URI different from
# ${MUSEFORGE_PUBLIC_BASE_URL}/callback.
# MUSEFORGE_GOOGLE_REDIRECT_URI=https://<host>/callback
# Comma-separated allowlist of email domains permitted to authenticate.
MUSEFORGE_ALLOWED_EMAIL_DOMAINS=feedmob.com
# Google OAuth Web-application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Auth store backend ---
# `memory` (default; single-instance only — fine for `museforge-mcp-http` on your own box)
# or `redis` (persistent; required for Vercel Functions / any serverless platform).
MUSEFORGE_AUTH_STORE=memory
# Required only when MUSEFORGE_AUTH_STORE=redis. Vercel auto-injects these when you
# install the Upstash Redis integration from the Marketplace.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
