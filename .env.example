# MuseForge configuration (copy to .env and fill in as needed).
# The core path works with NO keys — the Assistant falls back to deterministic heuristics.

# --- LLM provider (optional) ---
# Used for intent understanding, knowledge extraction, creative direction, and composition.
# Leave unset to use the deterministic heuristic fallback.
MUSEFORGE_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Embedding provider (optional) ---
# Used for semantic dedup and semantic search.
# Leave unset to use the local (hash/TF-IDF) fallback.
MUSEFORGE_EMBEDDING_PROVIDER=local

# --- Knowledge store ---
MUSEFORGE_DATA_DIR=data
