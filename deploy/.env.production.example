# Production environment for MuseForge MCP (used by deploy/museforge-mcp-http.service).
# Copy to /opt/museforge/.env on the server and fill in real values.
# Do NOT commit /opt/museforge/.env.

# --- Google OAuth (from Google Cloud Console > Credentials) ---
GOOGLE_CLIENT_ID=REPLACE.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE

# --- Public URL (must match Cloudflare Tunnel DNS + Google Console redirect URI) ---
MUSEFORGE_PUBLIC_BASE_URL=https://museforge.yourdomain.com
MUSEFORGE_GOOGLE_REDIRECT_URI=https://museforge.yourdomain.com/callback

# --- Org allowlist (feedmob-only by default) ---
MUSEFORGE_ALLOWED_EMAIL_DOMAINS=feedmob.com

# --- Server bind (loopback; cloudflared tunnels to 127.0.0.1:8000) ---
MUSEFORGE_HOST=127.0.0.1
MUSEFORGE_PORT=8000

# --- Knowledge store (persistent on the VPS; mount a volume here) ---
MUSEFORGE_DATA_DIR=/opt/museforge/data
